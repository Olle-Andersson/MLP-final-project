    "# plot KDE and Histogram for each feature\n",
    "def plot_distributions(df, features):\n",
    "    fig, axes = plt.subplots(len(features), 2, \n",
    "                    figsize=(7, 4*len(features)), dpi=200)\n",
    "\n",
    "    for i, feature in enumerate(features):\n",
    "        # KDE plot\n",
    "        sns.kdeplot(df[feature], fill=True, \n",
    "                    color=\"#4991d9\", \n",
    "                    lw=2, ax=axes[i,0])\n",
    "        axes[i, 0].set_xlabel(feature)\n",
    "        axes[i, 0].set_ylabel(\"Density\")\n",
    "        axes[i, 0].set_title(f\"KDE {feature}\")\n",
    "        axes[i, 0].grid(True)\n",
    "\n",
    "        # Histogram with KDE\n",
    "        sns.histplot(df[feature], kde=True, \n",
    "                     bins=25, \n",
    "                     color=\"#BB57CA\", \n",
    "                     edgecolor=\"k\", \n",
    "                     ax=axes[i,1])\n",
    "        axes[i, 1].set_xlabel(feature)\n",
    "        axes[i, 1].set_ylabel(\"Counts\")\n",
    "        axes[i, 1].set_title(f\"Histogram {feature}\")\n",
    "        axes[i, 1].grid(True)\n",
    "\n",
    "        fig.tight_layout()\n",
    "\n",
    "features = [c for c in exp_df.columns if c != \"Label\"]\n",
    "X = exp_df[features]\n",
    "plot_distributions(X, features)"
   ]
  },
